generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TransportMode {
  CAB
  AUTO
  BUS
  TRAIN
  FLIGHT
  CAR
  OTHER
}

enum ArrivalTerminalType {
  RAILWAY_STATION
  AIRPORT
  BUS_STAND
}

enum CompanionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

//User Model

model User {
  id String @id @default(cuid())

  name         String
  email        String  @unique
  passwordHash String?

  phoneNumber String?
  gender      Gender?

  role   UserRole   @default(STUDENT)
  status UserStatus @default(ACTIVE)

  authProvider AuthProvider @default(LOCAL)
  googleId     String?      @unique

  emailVerified Boolean @default(false)

  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  refreshSessions           RefreshSession[]
  profileCompleted          Boolean            @default(false)
  travelOffers              TravelOffer[]
  travelRequests            TravelRequest[]
  companionRequestsSent     CompanionRequest[] @relation("CompanionRequestSender")
  companionRequestsReceived CompanionRequest[] @relation("CompanionRequestRecipient")
  messagesSent              Message[]          @relation("MessageSender")
  ratingsGiven              Rating[]           @relation("RatingAuthor")
  ratingsReceived           Rating[]           @relation("RatingSubject")
  reportsFiled              Report[]           @relation("ReportAuthor")
  reportsReceived           Report[]           @relation("ReportSubject")
  travelDocuments           TravelDocument[]
}

//Refresh Session 
model RefreshSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
}

model TravelOffer {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  source         String
  destination    String
  terminalType   ArrivalTerminalType?
  terminalName   String?
  terminalKey    String?
  departureAt    DateTime
  expiresAt      DateTime
  timeFlexibilityMinutes Int?
  transportMode  TransportMode
  availableSeats Int

  isActive Boolean @default(true)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companionRequests CompanionRequest[]
}

model TravelRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  source       String
  destination  String
  terminalType ArrivalTerminalType?
  terminalName String?
  terminalKey  String?
  departureAt  DateTime
  expiresAt    DateTime
  timeFlexibilityMinutes Int?
  cancelledAt  DateTime?

  transportMode      TransportMode?
  passengersRequired Int            @default(1)

  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companionRequests CompanionRequest[]

  @@index([userId])
  @@index([isActive, departureAt])
  @@index([source, destination, departureAt])
}

model CompanionRequest {
  id String @id @default(cuid())

  // Student initiating the request
  senderId String
  sender   User   @relation("CompanionRequestSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Student receiving the request
  recipientId String
  recipient   User   @relation("CompanionRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Travel request involved in the match
  travelRequestId String
  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)

  // Selected travel offer
  offerId String
  offer   TravelOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  status CompanionRequestStatus @default(PENDING)

  // Deadline for accepting the request
  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  journey   Journey?
  messages  Message[]

  @@index([senderId, status])
  @@index([recipientId, status])
  @@index([offerId, status])
  @@index([travelRequestId])
  @@index([status, expiresAt])
}

enum JourneyStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum TravelDocumentStatus {
  PROCESSING
  COMPLETED
  FAILED
  CONFIRMED
}

model Journey {
  id                 String           @id @default(cuid())
  companionRequestId String           @unique
  companionRequest   CompanionRequest @relation(fields: [companionRequestId], references: [id], onDelete: Cascade)
  status             JourneyStatus    @default(CONFIRMED)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           Message[]
  ratings            Rating[]
  reports            Report[]
}

model Message {
  id        String           @id @default(cuid())
  journeyId String
  journey   Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  requestId String
  request   CompanionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime         @default(now())

  @@index([journeyId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([journeyId, authorId])
}

model Report {
  id        String       @id @default(cuid())
  journeyId String?
  journey   Journey?     @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  authorId  String
  author    User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User         @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reason    String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TravelDocument {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String
  ocrStatus     TravelDocumentStatus @default(PROCESSING)
  rawText       String?
  source        String?
  destination   String?
  departureAt   DateTime?
  transportMode TransportMode?
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, createdAt])
}
