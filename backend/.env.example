# Copy to backend/.env and replace every placeholder with local values.
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/YOUR_DATABASE_NAME?schema=public

# Use separate, strong random values for these secrets.
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
REFRESH_TOKEN_EXPIRY=7d

# Optional; configure only if Google sign-in is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
