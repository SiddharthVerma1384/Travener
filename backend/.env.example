# Server
PORT=8000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/travener-crud"

# JWT (use any long random string; each person can use their own)
ACCESS_TOKEN_SECRET="replace_with_a_long_random_string"
ACCESS_TOKEN_EXPIRY=5m

REFRESH_TOKEN_SECRET="replace_with_a_different_long_random_string"
REFRESH_TOKEN_EXPIRY=24h


GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback